  {
    "name": "Studio & brand",
    "settings": [
      {
        "type": "header",
        "content": "Text logo",
        "info": "Shown when no logo image is uploaded under Logo."
      },
      {
        "type": "text",
        "id": "wordmark_name",
        "label": "Name",
        "default": "Kolam & Clay"
      },
      {
        "type": "text",
        "id": "wordmark_tagline",
        "label": "Tagline",
        "default": "Pottery Studio"
      },
      {
        "type": "checkbox",
        "id": "wordmark_emblem",
        "label": "Show pot emblem",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_leaves",
        "label": "Show leaf decorations",
        "default": true
      },
      {
        "type": "header",
        "content": "Decoration"
      },
      {
        "type": "checkbox",
        "id": "show_ornaments",
        "label": "Show kolam ornaments",
        "default": true
      },
      {
        "type": "color",
        "id": "ornament_color",
        "label": "Ornament colour",
        "default": "#C0712E"
