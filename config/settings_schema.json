      {
        "type": "header",
        "content": "Studio details",
        "info": "Used in search engine structured data and the workshop page."
      },
      {
        "type": "text",
        "id": "studio_street",
        "label": "Street address",
        "default": "14, 2nd Cross Street, Gandhi Nagar"
      },
      {
        "type": "text",
        "id": "studio_locality",
        "label": "Area and city",
        "default": "Adyar, Chennai"
      },
      {
        "type": "text",
        "id": "studio_region",
        "label": "State",
        "default": "Tamil Nadu"
      },
      {
        "type": "text",
        "id": "studio_postcode",
        "label": "PIN code",
        "default": "600020"
      },
      {
        "type": "text",
        "id": "studio_phone",
        "label": "Phone",
        "default": "+91 98400 00000"
      },
      {
        "type": "text",
        "id": "studio_founded",
        "label": "Year founded",
        "default": "2019"
      },
      {
        "type": "header",
        "content": "Gift notes in the cart"
      },
      {
        "type": "text",
        "id": "gift_note_label",
        "label": "Field label",
        "default": "Add a gift note (up to 40 characters)"
      },
      {
        "type": "text",
        "id": "gift_note_placeholder",
        "label": "Placeholder",
        "default": "Happy housewarming, Anu!"
      },
      {
        "type": "text",
        "id": "gift_note_save",
        "label": "Save button",
        "default": "Save note"
      },
      {
        "type": "text",
        "id": "gift_note_saved",
        "label": "Saved message",
        "default": "Note saved"
