{{ 'section-collection-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign heading = section.settings.heading | default: collection.title | default: page_title
  assign intro = section.settings.text
  if intro == blank
    assign intro = collection.description
  endif
  assign image = collection.image | default: section.settings.image
-%}
<div class="collection-hero-kc color-{{ section.settings.color_scheme }} gradient" style="--hero-h: {{ section.settings.height }}rem;">
  {%- if image != blank -%}
    <div class="collection-hero-kc__media">
      {{ image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    </div>
  {%- endif -%}
  {%- if section.settings.show_ornament -%}{%- render 'kolam-ornament', class: 'collection-hero-kc__ornament' -%}{%- endif -%}
  <div class="collection-hero-kc__content page-width">
    <h1 class="collection-hero-kc__title">{{ heading }}</h1>
    {%- if intro != blank -%}<div class="collection-hero-kc__text kc-rte">{{ intro }}</div>{%- endif -%}
  </div>
  {%- if section.settings.accent != blank -%}
    <p class="collection-hero-kc__accent kc-italic" aria-hidden="true">{{ section.settings.accent | newline_to_br }}</p>
  {%- endif -%}
</div>

{%- unless section.settings.leaves == 'none' or section.settings.leaves == blank -%}
  {%- assign leaf_class = 'leaf-sprig--' | append: section.settings.leaves -%}
  {%- render 'leaf-sprig', class: leaf_class -%}
{%- endunless -%}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section section-collection-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection name."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when a collection has no image of its own."
    },
    {
      "type": "textarea",
      "id": "accent",
      "label": "Handwritten accent",
      "default": "Handmade\nin Chennai"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show kolam ornament",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "rem",
      "default": 28
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "leaves",
      "label": "Leaf decoration",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
