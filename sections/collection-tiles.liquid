{{ 'section-collection-tiles.css' | asset_url | stylesheet_tag }}
<div class="collection-tiles color-{{ section.settings.color_scheme }} gradient kc-section" style="--kc-pt: {{ section.settings.padding_top }}px; --kc-pb: {{ section.settings.padding_bottom }}px; --tiles-cols: {{ section.settings.columns }};">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="kc-head kc-head--center">
        {%- if section.settings.heading != blank -%}
          <h2 class="kc-head__title {{ section.settings.heading_size }}{% if section.settings.flourish %} kc-flourish-title{% endif %}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="kc-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="collection-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign label = block.settings.label | default: collection.title
          assign image = block.settings.image | default: collection.featured_image
          assign url = block.settings.link | default: collection.url
        -%}
        <li class="collection-tiles__item" {{ block.shopify_attributes }}>
          <a class="collection-tiles__card" href="{{ url | default: '#' }}">
            <span class="collection-tiles__media">
              {%- if image != blank -%}
                {{ image | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="collection-tiles__label">
              {{ label | default: 'Collection' }}
              {%- render 'line-icon', name: 'arrow' -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>


{%- unless section.settings.leaves == 'none' or section.settings.leaves == blank -%}
  {%- assign leaf_class = 'leaf-sprig--' | append: section.settings.leaves -%}
  {%- render 'leaf-sprig', class: leaf_class -%}
{%- endunless -%}

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "class": "section section-collection-tiles",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our collections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "flourish",
      "label": "Show lines beside heading",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Made slowly, for your home and the people you love"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Tiles per row on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "leaves",
      "label": "Leaf decoration",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Leave blank to use the collection name."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave blank to use the collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Overrides the collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
