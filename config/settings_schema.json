      {
        "type": "header",
        "content": "Glaze swatches",
        "info": "One glaze per line as Name:#hex. Used on product pages, product cards and filters."
      },
      {
        "type": "textarea",
        "id": "glaze_swatches",
        "label": "Glaze colours",
        "default": "Matte Beige:#E6D3BC\nOcean Blue:#2F5F78\nEarthy Brown:#8A4320\nSage Green:#8FA27A"
      },
      {
        "type": "text",
        "id": "glaze_option_names",
        "label": "Option names treated as glaze",
        "default": "Glaze,Colour,Color",
        "info": "Comma separated."
      },
      {
        "type": "header",
        "content": "One-of-a-kind pieces"
      },
      {
        "type": "text",
        "id": "ooak_badge",
        "label": "Badge text",
        "default": "One of a kind"
      },
      {
        "type": "text",
        "id": "ooak_low_stock",
        "label": "Available label",
        "default": "Only 1 made"
      },
      {
        "type": "text",
        "id": "ooak_sold_badge",
        "label": "Sold badge text",
        "default": "Sold · From our archive"
      },
      {
        "type": "richtext",
        "id": "ooak_sold_message",
        "label": "Sold message on product page",
