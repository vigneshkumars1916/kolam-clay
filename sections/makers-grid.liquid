{{ 'section-makers-grid.css' | asset_url | stylesheet_tag }}
<div class="makers-grid color-{{ section.settings.color_scheme }} kc-section" style="--kc-pt: {{ section.settings.padding_top }}px; --kc-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="kc-head kc-head--center makers-grid__head">
      <h1 class="kc-head__title kc-flourish-title">{{ section.settings.heading | default: page.title }}</h1>
      {%- if page.content != blank and section.settings.show_page_content -%}
        <div class="kc-head__sub rte">{{ page.content }}</div>
      {%- endif -%}
    </div>
    <ul class="makers-grid__list" role="list">
      {%- for maker in shop.metaobjects.potter.values -%}
        <li class="maker-card">
          <a href="{{ maker.system.url }}" class="maker-card__link">
            <span class="maker-card__media">
              {%- if maker.feature_image != blank and section.settings.use_feature_image -%}
                {{ maker.feature_image.value | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy', alt: '' }}
              {%- elsif maker.portrait != blank -%}
                {{ maker.portrait.value | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- render 'kolam-ornament' -%}
              {%- endif -%}
            </span>
            <span class="maker-card__body">
              <span class="maker-card__role">{{ maker.role.value }}</span>
              <span class="maker-card__name h2">{{ maker.name.value }}</span>
              {%- if maker.short_bio != blank -%}<span class="maker-card__bio">{{ maker.short_bio.value }}</span>{%- endif -%}
              {%- assign maker_first = maker.name.value | split: ' ' | first -%}
              <span class="kc-link-arrow">{{ section.settings.link_label | replace: '[name]', maker_first }}{%- render 'line-icon', name: 'arrow' -%}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Potters grid",
  "tag": "section",
  "class": "section section-makers-grid",
  "settings": [
    { "type": "paragraph", "content": "Lists every potter from Content → Metaobjects → Potter." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "checkbox", "id": "show_page_content", "label": "Show page content under the heading", "default": true },
    { "type": "checkbox", "id": "use_feature_image", "label": "Prefer the feature image over the portrait", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See [name]'s work" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Potters grid" } ]
}
{% endschema %}
