{{ 'section-icon-strip.css' | asset_url | stylesheet_tag }}
<div class="icon-strip color-{{ section.settings.color_scheme }} gradient kc-section" style="--kc-pt: {{ section.settings.padding_top }}px; --kc-pb: {{ section.settings.padding_bottom }}px;">
  <ul class="icon-strip__list page-width" role="list">
    {%- for block in section.blocks -%}
      <li class="icon-strip__item" {{ block.shopify_attributes }}>
        {%- if block.settings.custom_icon != blank -%}
          {{ block.settings.custom_icon | image_url: width: 80 | image_tag: width: 32, height: 32, loading: 'lazy', alt: '', class: 'icon-strip__img' }}
        {%- else -%}
          {%- render 'line-icon', name: block.settings.icon, class: 'icon-strip__icon' -%}
        {%- endif -%}
        <div class="icon-strip__text">
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {{ block.settings.text }}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>


{% schema %}
{
  "name": "Icon strip",
  "tag": "section",
  "class": "section section-icon-strip",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Delivery truck" }, { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" },
          { "value": "heart", "label": "Heart" }, { "value": "hand", "label": "Hand" }, { "value": "gift", "label": "Gift" },
          { "value": "box", "label": "Box" }, { "value": "sprout", "label": "Sprout" }, { "value": "flame", "label": "Kiln flame" },
          { "value": "calendar", "label": "Calendar" }, { "value": "pin", "label": "Location" }, { "value": "chat", "label": "Chat" }
        ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Replaces the icon above. Square image, at least 64px." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Free shipping<br>above ₹1,499</p>" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Icon strip", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] }
  ]
}
{% endschema %}
